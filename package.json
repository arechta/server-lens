{
  "name": "server-lens",
  "version": "0.1.0",
  "description": "Snapshot server state — tools, runtimes, versions. Stage 1 of DevOps pipeline.",
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "server-lens": "src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outdir=dist --target=bun",
    "build:linux": "bun build src/index.tsx --compile --target=bun-linux-x64 --outfile=dist/server-lens",
    "build:linux-arm64": "bun build src/index.tsx --compile --target=bun-linux-arm64 --outfile=dist/server-lens-arm64",
    "postinstall": "bun scripts/patch-yoga.js"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "cron-parser": "^4.9.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ink": "^4.4.0",
    "react": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
